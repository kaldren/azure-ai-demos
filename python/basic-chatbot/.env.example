# From the Bicep deployment outputs (see README "Deploy").
FOUNDRY_PROJECT_ENDPOINT=https://<foundry-account>.services.ai.azure.com/api/projects/proj-chatbot
FOUNDRY_MODEL_DEPLOYMENT=gpt-5.4-mini

# The prompt agent's name, and the version chat.py pins to (printed by create_agent.py).
FOUNDRY_AGENT_NAME=basic-chatbot
FOUNDRY_AGENT_VERSION=1

# Optional: also put prompt/response text into the --trace spans (off by default).
# ENABLE_SENSITIVE_DATA=true

# Step 2: grounding with Azure AI Search (from the Bicep outputs).
FOUNDRY_EMBEDDING_DEPLOYMENT=text-embedding-3-small
SEARCH_ENDPOINT=https://<search-service>.search.windows.net
SEARCH_CONNECTION_NAME=search
SEARCH_INDEX_NAME=policies

# Step 4: standard agent setup (from the Bicep outputs).
# FOUNDRY_PROJECT_ENDPOINT now points at the standard-setup project:
#   https://<foundry-account>.services.ai.azure.com/api/projects/proj-chatbot-std
COSMOS_ACCOUNT_NAME=cosmos-<baseName>-<suffix>
